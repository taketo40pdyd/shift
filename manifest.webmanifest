{
  "id": "./",
  "name": "シフト管理",
  "short_name": "シフト管理",
  "description": "スタッフのシフト作成・希望収集・人員不足チェック・給与目安の計算・PDF/CSV/ICS出力までできるシフト管理アプリです。",
  "lang": "ja",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#F1F3F0",
  "theme_color": "#1F4B43",
  "categories": [
    "business",
    "productivity"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "シフト表",
      "short_name": "シフト表",
      "description": "今月のシフト表を開く",
      "url": "./?view=schedule&period=current&source=shortcut",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "希望を入力",
      "short_name": "希望入力",
      "description": "スタッフの希望シフトを入力する",
      "url": "./?view=schedule&mode=request&source=shortcut",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "スタッフ",
      "short_name": "スタッフ",
      "description": "スタッフ一覧を開く",
      "url": "./?view=staff&source=shortcut",
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "application/json": [
          ".json"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png?v=2",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "backup",
          "accept": [
            "application/json",
            ".json"
          ]
        }
      ]
    }
  },
  "screenshots": [
    {
      "src": "screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "月ごとのシフト表と集計"
    },
    {
      "src": "screenshot-narrow.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "スマホでシフトを入力"
    },
    {
      "src": "screenshot-portal.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "スタッフ用ページで希望を提出"
    }
  ]
}